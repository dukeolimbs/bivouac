# Normalize to LF in the repo and on checkout, so line endings stay stable
# across machines and parallel work (matches .editorconfig).
* text=auto eol=lf

# Treat common binary assets as binary (no EOL munging).
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.svg  text eol=lf
*.woff  binary
*.woff2 binary
*.ogg  binary
*.webm binary
*.mp3  binary
