{
  "name": "bivouac",
  "version": "1.3.1",
  "description": "A persistent campaign landing page for Foundry VTT: a zoomable board of tiles, a GM DM screen, and a Cast Bar.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "lint": "eslint src",
    "link": "node ../scripts/link-module.mjs .",
    "unlink": "node ../scripts/link-module.mjs . --remove",
    "package": "npm run build && node ../scripts/package.mjs ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
